{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariadne.local/schemas/truth_persistence_v1.schema.json",
  "title": "Ariadne truth and persistence contracts v1",
  "description": "Canonical cross-language contract for Ariadne local truth and durable Candidate and Job conversation objects. Persistence never changes an object's authority role.",
  "x-contract-id": "ariadne-truth-persistence-v1",
  "x-indexeddb-name": "job-radar-local-first-v1",
  "x-indexeddb-version": 20,
  "x-status-semantics": {
    "processing_run": "Records actual execution outcome and is never retroactively rewritten because a later user workflow was cancelled.",
    "processing_batch": "Records workflow disposition; CANCELLED remains CANCELLED even if an in-flight execution later succeeds or fails.",
    "proposal": "A Proposal abandoned by workflow cancellation is CANCELLED_BY_USER and remains non-authoritative.",
    "cancelled_run_invariant": "A ProcessingRun that actually stopped as CANCELLED cannot produce a new Proposal after cancellation.",
    "candidate_context_removal": "A Candidate context REMOVED by the user is excluded from active current truth while its revisions, source documents, extraction artifacts, proposals, review decisions, and historical provenance remain retained.",
    "candidate_working_model": "A Candidate Working Model is an immutable, non-authoritative versioned draft. User edits create a new version instead of rewriting the prior snapshot.",
    "candidate_workspace_acceptance": "A Workspace Acceptance is one immutable Human authority event accepting one exact Working Model version and fingerprint; it is not a set of per-Proposal ReviewDecisions.",
    "candidate_conversation": "Conversation messages and CandidateActions are append-only history; a mutable TurnExecution retains its complete state_history while Working Model versions retain their own lineage.",
    "candidate_conversation_failure": "A USER message may exist without an ASSISTANT message when its durable TurnExecution fails, is cancelled, or becomes stale."
  },
  "x-stores": [
    {"name": "applications", "keyPath": "job_context_id", "lifecycle": "new"},
    {"name": "job_journal_entries", "keyPath": "entry_id", "lifecycle": "new"},
    {"name": "job_journal_images", "keyPath": "image_id", "lifecycle": "new"},
    {"name": "job_followup_migrations", "keyPath": "migration_id", "lifecycle": "new"},

    { "name": "source_documents", "keyPath": "source_document_id", "lifecycle": "reused" },
    { "name": "runtime_snapshots", "keyPath": "snapshot_id", "lifecycle": "new" },
    { "name": "extraction_artifacts", "keyPath": "artifact_id", "lifecycle": "new" },
    { "name": "processing_runs", "keyPath": "run_id", "lifecycle": "reused" },
    { "name": "processing_batches", "keyPath": "batch_id", "lifecycle": "new" },
    { "name": "context_proposals", "keyPath": "proposal_id", "lifecycle": "new" },
    { "name": "context_review_decisions", "keyPath": "review_id", "lifecycle": "new" },
    { "name": "candidate_working_models", "keyPath": "working_model_id", "lifecycle": "new" },
    { "name": "candidate_workspace_acceptances", "keyPath": "acceptance_id", "lifecycle": "new" },
    { "name": "candidate_context_revisions", "keyPath": "revision_id", "lifecycle": "new" },
    { "name": "candidate_context_lifecycle", "keyPath": "lifecycle_id", "lifecycle": "new" },
    { "name": "job_context_revisions", "keyPath": "revision_id", "lifecycle": "new" },
    { "name": "job_context_lifecycle", "keyPath": "lifecycle_id", "lifecycle": "new" },
    { "name": "conversation_sessions", "keyPath": "conversation_id", "lifecycle": "reused" },
    { "name": "conversation_messages", "keyPath": "message_id", "lifecycle": "reused" },
    { "name": "conversation_turn_executions", "keyPath": "execution_id", "lifecycle": "new" },
    { "name": "candidate_actions", "keyPath": "action_id", "lifecycle": "new" },
    { "name": "job_analyses", "keyPath": "analysis_id", "lifecycle": "new" },
    { "name": "job_conversation_sessions", "keyPath": "conversation_id", "lifecycle": "new" },
    { "name": "job_conversation_messages", "keyPath": "message_id", "lifecycle": "new" },
    { "name": "job_turn_executions", "keyPath": "execution_id", "lifecycle": "new" },
    { "name": "job_change_proposals", "keyPath": "job_change_proposal_id", "lifecycle": "new" },
    { "name": "job_change_decisions", "keyPath": "job_change_decision_id", "lifecycle": "new" },
    {"name": "personal_memory_revisions", "keyPath": "revision_id", "lifecycle": "new"},
    {"name": "personal_memory_proposals", "keyPath": "proposal_id", "lifecycle": "new"},
    {"name": "personal_memory_decisions", "keyPath": "decision_id", "lifecycle": "new"},
    {"name": "personal_understanding_fragments", "keyPath": "fragment_id", "lifecycle": "new"},
    {"name": "personal_understanding_snapshots", "keyPath": "understanding_id", "lifecycle": "new"},
    {"name": "resume_tasks", "keyPath": "task_id", "lifecycle": "new"},
    {"name": "resume_document_versions", "keyPath": "version_id", "lifecycle": "new"},
    {"name": "personal_conversation_turns", "keyPath": "turn_id", "lifecycle": "new"},
    {"name": "job_overview_fragments", "keyPath": "fragment_id", "lifecycle": "new"},
    {"name": "job_overview_snapshots", "keyPath": "overview_id", "lifecycle": "new"},
    {"name": "job_overview_turns", "keyPath": "turn_id", "lifecycle": "new"}
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "isoTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_document_id", "location", "excerpt_or_reference"],
      "properties": {
        "source_document_id": { "$ref": "#/$defs/nonEmptyString" },
        "location": { "$ref": "#/$defs/nonEmptyString" },
        "excerpt_or_reference": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "source_document_id",
        "source_type",
        "filename",
        "label",
        "mime_type",
        "content_hash",
        "created_at",
        "material_type",
        "local_reference",
        "batch_id",
        "provenance",
        "authority"
      ],
      "properties": {
        "contract_id": { "const": "ariadne-source-document-v1" },
        "source_document_id": { "$ref": "#/$defs/nonEmptyString" },
        "source_type": { "enum": ["PDF", "DOCX", "TXT", "MARKDOWN", "IMAGE", "PASTED_TEXT"] },
        "filename": { "$ref": "#/$defs/nullableString" },
        "label": { "$ref": "#/$defs/nullableString" },
        "mime_type": { "$ref": "#/$defs/nullableString" },
        "content_hash": { "$ref": "#/$defs/nonEmptyString" },
        "created_at": { "$ref": "#/$defs/isoTimestamp" },
        "material_type": { "enum": ["CANDIDATE", "JOB"] },
        "local_reference": { "$ref": "#/$defs/nullableString" },
        "batch_id": { "$ref": "#/$defs/nullableString" },
        "provenance": { "type": "object" },
        "authority": { "const": "SOURCE_INPUT_ONLY" }
      }
    },
    "extractionArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "artifact_id",
        "source_document_id",
        "processing_run_id",
        "extraction_method",
        "payload",
        "source_refs",
        "quality",
        "warnings",
        "errors",
        "created_at",
        "authority"
      ],
      "properties": {
        "contract_id": { "const": "ariadne-extraction-artifact-v1" },
        "artifact_id": { "$ref": "#/$defs/nonEmptyString" },
        "source_document_id": { "$ref": "#/$defs/nonEmptyString" },
        "processing_run_id": { "$ref": "#/$defs/nonEmptyString" },
        "extraction_method": { "$ref": "#/$defs/nonEmptyString" },
        "payload": { "type": "object" },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "quality": { "type": ["object", "null"] },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "errors": { "type": "array", "items": { "type": "string" } },
        "created_at": { "$ref": "#/$defs/isoTimestamp" },
        "authority": { "const": "NON_AUTHORITATIVE_EXTRACTION" }
      }
    },
    "processingRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "run_id",
        "operation_type",
        "source_document_id",
        "batch_id",
        "runtime_snapshot_id",
        "started_at",
        "finished_at",
        "status",
        "error_code",
        "output_artifact_ids",
        "proposal_ids",
        "authority"
      ],
      "properties": {
        "contract_id": { "const": "ariadne-processing-run-v1" },
        "run_id": { "$ref": "#/$defs/nonEmptyString" },
        "operation_type": { "$ref": "#/$defs/nonEmptyString" },
        "source_document_id": { "$ref": "#/$defs/nullableString" },
        "batch_id": { "$ref": "#/$defs/nullableString" },
        "runtime_snapshot_id": { "$ref": "#/$defs/nonEmptyString" },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "finished_at": { "type": ["string", "null"], "format": "date-time" },
        "status": { "enum": ["PENDING", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"] },
        "error_code": { "$ref": "#/$defs/nullableString" },
        "output_artifact_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "proposal_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "authority": { "const": "EXECUTION_HISTORY" }
      }
    },
    "processingBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "batch_id",
        "operation_type",
        "source_document_ids",
        "completed_source_ids",
        "cancelled_source_id",
        "not_started_source_ids",
        "status",
        "created_at",
        "finished_at",
        "cancelled_at",
        "cancel_reason",
        "authority"
      ],
      "properties": {
        "contract_id": { "const": "ariadne-processing-batch-v1" },
        "batch_id": { "$ref": "#/$defs/nonEmptyString" },
        "operation_type": { "$ref": "#/$defs/nonEmptyString" },
        "source_document_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "completed_source_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "cancelled_source_id": { "$ref": "#/$defs/nullableString" },
        "not_started_source_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "status": { "enum": ["PENDING", "RUNNING", "COMPLETED", "FAILED", "CANCELLED"] },
        "created_at": { "$ref": "#/$defs/isoTimestamp" },
        "finished_at": { "type": ["string", "null"], "format": "date-time" },
        "cancelled_at": { "type": ["string", "null"], "format": "date-time" },
        "cancel_reason": { "$ref": "#/$defs/nullableString" },
        "authority": { "const": "EXECUTION_HISTORY" }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "proposal_id",
        "proposal_type",
        "source_document_ids",
        "processing_run_id",
        "runtime_snapshot_id",
        "status",
        "created_at",
        "payload",
        "grounding_refs",
        "warnings",
        "uncertainties",
        "authority"
      ],
      "properties": {
        "contract_id": { "const": "ariadne-context-proposal-v1" },
        "proposal_id": { "$ref": "#/$defs/nonEmptyString" },
        "proposal_type": { "enum": ["CANDIDATE_CONTEXT", "JOB_CONTEXT"] },
        "source_document_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "processing_run_id": { "$ref": "#/$defs/nonEmptyString" },
        "runtime_snapshot_id": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["AWAITING_REVIEW", "ACCEPTED", "REJECTED", "CANCELLED_BY_USER", "SUPERSEDED"] },
        "created_at": { "$ref": "#/$defs/isoTimestamp" },
        "payload": { "type": "object" },
        "grounding_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "uncertainties": { "type": "array", "items": {} },
        "authority": { "const": "NON_AUTHORITATIVE_PROPOSAL" }
      }
    },
    "reviewDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "review_id", "proposal_id", "decision", "reviewed_at", "accepted_payload", "authority"],
      "properties": {
        "contract_id": { "const": "ariadne-context-review-decision-v1" },
        "review_id": { "$ref": "#/$defs/nonEmptyString" },
        "proposal_id": { "$ref": "#/$defs/nonEmptyString" },
        "decision": { "enum": ["CONFIRM", "REJECT", "EDIT_AND_CONFIRM"] },
        "reviewed_at": { "$ref": "#/$defs/isoTimestamp" },
        "accepted_payload": { "type": ["object", "null"] },
        "authority": { "const": "AUTHORITATIVE_USER_DECISION" }
      }
    },
    "candidateWorkingModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "working_model_id", "source_document_id", "processing_run_id", "runtime_snapshot_id", "proposal_ids", "version", "previous_working_model_id", "fingerprint", "created_at", "payload", "authority"],
      "properties": {
        "contract_id": { "const": "ariadne-candidate-working-model-v1" },
        "working_model_id": { "$ref": "#/$defs/nonEmptyString" },
        "source_document_id": { "$ref": "#/$defs/nonEmptyString" },
        "processing_run_id": { "$ref": "#/$defs/nonEmptyString" },
        "runtime_snapshot_id": { "$ref": "#/$defs/nonEmptyString" },
        "proposal_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "version": { "type": "integer", "minimum": 1 },
        "previous_working_model_id": { "$ref": "#/$defs/nullableString" },
        "fingerprint": { "$ref": "#/$defs/nonEmptyString" },
        "created_at": { "$ref": "#/$defs/isoTimestamp" },
        "payload": { "type": "object" },
        "authority": { "const": "NON_AUTHORITATIVE_WORKING_MODEL" }
      }
    },
    "candidateWorkspaceAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "acceptance_id", "context_id", "source_document_id", "processing_run_id", "runtime_snapshot_id", "proposal_ids", "working_model_id", "working_model_version", "working_model_fingerprint", "accepted_at", "confirmed_revision_id", "previous_revision_id", "accepted_payload", "authority"],
      "properties": {
        "contract_id": { "const": "ariadne-candidate-workspace-acceptance-v1" },
        "acceptance_id": { "$ref": "#/$defs/nonEmptyString" },
        "context_id": { "$ref": "#/$defs/nonEmptyString" },
        "source_document_id": { "$ref": "#/$defs/nonEmptyString" },
        "processing_run_id": { "$ref": "#/$defs/nonEmptyString" },
        "runtime_snapshot_id": { "$ref": "#/$defs/nonEmptyString" },
        "proposal_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "working_model_id": { "$ref": "#/$defs/nonEmptyString" },
        "working_model_version": { "type": "integer", "minimum": 1 },
        "working_model_fingerprint": { "$ref": "#/$defs/nonEmptyString" },
        "accepted_at": { "$ref": "#/$defs/isoTimestamp" },
        "confirmed_revision_id": { "$ref": "#/$defs/nonEmptyString" },
        "previous_revision_id": { "$ref": "#/$defs/nullableString" },
        "accepted_payload": { "type": "object" },
        "authority": { "const": "AUTHORITATIVE_WORKSPACE_ACCEPTANCE" }
      }
    },
    "workspaceContextRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "context_type", "context_id", "revision_id", "version", "previous_revision_id", "workspace_acceptance_id", "created_at", "provenance", "payload", "authority"],
      "properties": {
        "contract_id": { "const": "ariadne-context-revision-v2" },
        "context_type": { "const": "CANDIDATE" },
        "context_id": { "$ref": "#/$defs/nonEmptyString" },
        "revision_id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "type": "integer", "minimum": 1 },
        "previous_revision_id": { "$ref": "#/$defs/nullableString" },
        "workspace_acceptance_id": { "$ref": "#/$defs/nonEmptyString" },
        "created_at": { "$ref": "#/$defs/isoTimestamp" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_document_ids", "processing_run_id", "runtime_snapshot_id"],
          "properties": {
            "source_document_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
            "processing_run_id": { "$ref": "#/$defs/nonEmptyString" },
            "runtime_snapshot_id": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "payload": { "type": "object" },
        "authority": { "const": "AUTHORITATIVE_CONFIRMED_CONTEXT" }
      }
    },
    "contextRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "context_type",
        "context_id",
        "revision_id",
        "version",
        "previous_revision_id",
        "confirmed_from_proposal_id",
        "review_decision_id",
        "created_at",
        "provenance",
        "payload",
        "authority"
      ],
      "properties": {
        "contract_id": { "const": "ariadne-context-revision-v1" },
        "context_type": { "enum": ["CANDIDATE", "JOB"] },
        "context_id": { "$ref": "#/$defs/nonEmptyString" },
        "revision_id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "type": "integer", "minimum": 1 },
        "previous_revision_id": { "$ref": "#/$defs/nullableString" },
        "confirmed_from_proposal_id": { "$ref": "#/$defs/nonEmptyString" },
        "review_decision_id": { "$ref": "#/$defs/nonEmptyString" },
        "created_at": { "$ref": "#/$defs/isoTimestamp" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_document_ids", "processing_run_id", "runtime_snapshot_id"],
          "properties": {
            "source_document_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "processing_run_id": { "$ref": "#/$defs/nonEmptyString" },
            "runtime_snapshot_id": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "payload": { "type": "object" },
        "authority": { "const": "AUTHORITATIVE_CONFIRMED_CONTEXT" }
      }
    },
    "candidateConversationSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "conversation_id", "subject_type", "subject_id", "source_document_id", "created_at", "updated_at"],
      "properties": {
        "contract_id": { "const": "ariadne-candidate-conversation-v1" },
        "conversation_id": { "$ref": "#/$defs/nonEmptyString" },
        "subject_type": { "const": "CANDIDATE" },
        "subject_id": { "$ref": "#/$defs/nonEmptyString" },
        "source_document_id": { "$ref": "#/$defs/nonEmptyString" },
        "created_at": { "$ref": "#/$defs/isoTimestamp" },
        "updated_at": { "$ref": "#/$defs/isoTimestamp" }
      }
    },
    "candidateConversationMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "message_id", "conversation_id", "turn_id", "role", "text", "created_at", "provider", "model", "runtime_snapshot_id", "candidate_action_id"],
      "properties": {
        "contract_id": { "const": "ariadne-candidate-conversation-v1-message-v1" },
        "message_id": { "$ref": "#/$defs/nonEmptyString" },
        "conversation_id": { "$ref": "#/$defs/nonEmptyString" },
        "turn_id": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "enum": ["USER", "ASSISTANT"] },
        "text": { "$ref": "#/$defs/nonEmptyString" },
        "created_at": { "$ref": "#/$defs/isoTimestamp" },
        "provider": { "$ref": "#/$defs/nullableString" },
        "model": { "$ref": "#/$defs/nullableString" },
        "runtime_snapshot_id": { "$ref": "#/$defs/nullableString" },
        "candidate_action_id": { "$ref": "#/$defs/nullableString" }
      }
    },
    "candidateConversationTurnExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "execution_id", "conversation_id", "operation", "generation", "observation", "runtime_snapshot_id", "state", "state_history", "failure_code", "result_action", "created_at", "updated_at", "cancelled_at", "user_message_id", "action_id", "usage"],
      "properties": {
        "contract_id": { "const": "ariadne-candidate-conversation-v1-turn-execution-v1" },
        "execution_id": { "$ref": "#/$defs/nonEmptyString" },
        "conversation_id": { "$ref": "#/$defs/nonEmptyString" },
        "operation": { "const": "CANDIDATE_CONVERSATION_TURN" },
        "generation": { "$ref": "#/$defs/nonEmptyString" },
        "observation": { "type": "object" },
        "runtime_snapshot_id": { "$ref": "#/$defs/nonEmptyString" },
        "state": { "enum": ["CREATED", "SENDING", "RECEIVED", "VALIDATING", "APPLIED", "NO_CHANGE", "NEEDS_CLARIFICATION", "FAILED", "CANCELLED", "STALE"] },
        "state_history": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "failure_code": { "$ref": "#/$defs/nullableString" },
        "failure_diagnostics": { "type": ["object", "null"] },
        "result_action": { "$ref": "#/$defs/nullableString" },
        "created_at": { "$ref": "#/$defs/isoTimestamp" },
        "updated_at": { "$ref": "#/$defs/isoTimestamp" },
        "cancelled_at": { "type": ["string", "null"], "format": "date-time" },
        "user_message_id": { "$ref": "#/$defs/nonEmptyString" },
        "action_id": { "$ref": "#/$defs/nullableString" },
        "usage": { "type": "object" }
      }
    },
    "candidateActionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "action_id", "conversation_id", "turn_id", "originating_user_message_id", "observed_working_model", "focus_snapshot", "normalized_action", "validation_result", "application_result", "resulting_working_model_id", "model_response_hash", "created_at", "updated_at"],
      "properties": {
        "contract_id": { "const": "ariadne-candidate-conversation-action-v1-record-v1" },
        "action_id": { "$ref": "#/$defs/nonEmptyString" },
        "conversation_id": { "$ref": "#/$defs/nonEmptyString" },
        "turn_id": { "$ref": "#/$defs/nonEmptyString" },
        "originating_user_message_id": { "$ref": "#/$defs/nonEmptyString" },
        "observed_working_model": { "type": "object" },
        "focus_snapshot": { "type": "object" },
        "normalized_action": { "type": "object" },
